server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Angular es una SPA: cualquier ruta que no sea un archivo real (ej. /dashboard, /reportes al
    # refrescar la página) debe devolver index.html y que el router de Angular la resuelva.
    location / {
        try_files $uri $uri/ /index.html;
    }

    # environment.prod.ts usa apiUrl = '/api' (ruta relativa), así que nginx reenvía esas
    # llamadas al backend. BACKEND_HOST/BACKEND_PORT se definen en el Dockerfile (por defecto
    # "backend" y 3000 - el nombre del servicio en docker-compose) y se pueden sobrescribir con
    # -e al correr el contenedor.
    location /api/ {
        proxy_pass http://${BACKEND_HOST}:${BACKEND_PORT}/api/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    gzip on;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;
}

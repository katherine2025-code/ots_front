server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Angular es una SPA: cualquier ruta que no sea un archivo real (ej. /dashboard, /reportes al
    # refrescar la página) debe devolver index.html y que el router de Angular la resuelva.
    location / {
        try_files $uri $uri/ /index.html;
    }

    # NOTA: no hay proxy a /api aquí. Front y backend son apps separadas en Dokploy, cada una con
    # su propio dominio (no comparten red interna por nombre), así que environment.prod.ts llama
    # directo a la URL completa del backend - ver apiUrl ahí. Antes esto tenía un
    # "location /api/ { proxy_pass http://backend:3000; }", pero "backend" no existe como nombre
    # resoluble en este despliegue: nginx no podía arrancar (fallaba al resolver ese host al
    # iniciar) y por eso el contenedor daba "Bad Gateway" - todo el bloque sobraba una vez que el
    # front llama directo al backend.

    gzip on;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;
}
